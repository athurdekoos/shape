{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/athurdekoos/shape/main/schema/shape.schema.json",
  "title": "Programs described for shape",
  "description": "One program, a list of programs, or {\"machines\": [...]} that holds a list. A program is its states, the events each state takes, and the ordered branches of each event. Version 0.1. docs/FORMAT.md describes it in words. These rules are not expressed here and are checked by shape --check: initial must be one of the states, a description may name at most 2,000 states, counting the targets of its branches, and it may have at most 20,000 branches.",
  "anyOf": [
    {
      "$ref": "#/$defs/description"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/description"
      }
    },
    {
      "type": "object",
      "required": [
        "machines"
      ],
      "properties": {
        "machines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/description"
          }
        }
      }
    }
  ],
  "$defs": {
    "description": {
      "title": "A program described for shape",
      "type": "object",
      "required": [
        "id",
        "initial",
        "states"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The name shape lists the program under."
        },
        "initial": {
          "type": "string",
          "minLength": 1,
          "description": "The state the program starts in."
        },
        "about": {
          "type": [
            "string",
            "null"
          ],
          "description": "One sentence that says what the program is."
        },
        "defined_in": {
          "type": [
            "string",
            "null"
          ],
          "description": "The file the table is in."
        },
        "goal": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The state the program is meant to reach."
        },
        "attention": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The states a person should look at, usually the failures."
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "on": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": {
                          "oneOf": [
                            {
                              "$ref": "#/$defs/branch"
                            },
                            {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "$ref": "#/$defs/branch"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "maxProperties": 2000
        }
      }
    },
    "branch": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Shorthand: the name of the target state."
        },
        {
          "type": "object",
          "required": [
            "target"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "A name for the move, for your own logs. shape --check notes an id that two branches share."
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "description": "The state this branch leads to."
            },
            "guard": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Shorthand: the name of the condition."
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The name shown after \"if\"."
                    },
                    "says": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "One sentence that says what the condition means."
                    },
                    "source": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Where the condition is written, as path/file.py:line."
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "actions": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Names for what the move does."
            }
          }
        }
      ]
    }
  }
}
