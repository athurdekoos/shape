{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/athurdekoos/shape/schema/shape.schema.json",
  "title": "A program described for shape",
  "description": "One program as states, the events each state takes, and the ordered branches of each event. Version 0.1. docs/FORMAT.md describes it in words. Two rules are not expressed here and are checked by shape --check: initial must be one of the states, and an event's list must hold at least one branch.",
  "type": "object",
  "required": [
    "id",
    "initial",
    "states"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "The name shape lists the program under."
    },
    "initial": {
      "type": "string",
      "minLength": 1,
      "description": "The state the program starts in."
    },
    "about": {
      "type": [
        "string",
        "null"
      ],
      "description": "One sentence that says what the program is."
    },
    "defined_in": {
      "type": [
        "string",
        "null"
      ],
      "description": "The file the table is in."
    },
    "goal": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "The state the program is meant to reach."
    },
    "attention": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The states a person should look at, usually the failures."
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "on": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/branch"
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "$ref": "#/$defs/branch"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "branch": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Shorthand: the name of the target state."
        },
        {
          "type": "object",
          "required": [
            "target"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "A name for the move."
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "description": "The state this branch leads to."
            },
            "guard": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Shorthand: the name of the condition."
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The name shown after \"if\"."
                    },
                    "says": {
                      "type": "string",
                      "description": "One sentence that says what the condition means."
                    },
                    "source": {
                      "type": "string",
                      "description": "Where the condition is written, as path/file.py:line."
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "actions": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Names for what the move does."
            }
          }
        }
      ]
    }
  }
}
